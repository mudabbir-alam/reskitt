---
import Button from "./Button.astro";
const uniLogoURL = [
    "/images/kfueit-logo.png",
    "/images/muet-logo.png",
    "/images/ned-logo.png",
    "/images/nust-logo.png",
    "/images/iub-logo.png"
]
---

<section
    id="cta"
    class="py-16 mx-auto flex flex-col justify-center items-center border-border border-t-2"
>
    <h4 class="font-bold text-slate-600 dark:text-slate-400">
        TRUSTED BY STUDENTS FROM
    </h4>
    <div class="flex justify-around gap-4 mt-6 p-4 dark:bg-slate-800 w-full max-w-3xl">
        {uniLogoURL.map((item) => <img src={item} class="h-10 md:h-12 aspect-square"/>)}
    </div>
    <div
        class="mt-16 w-full max-w-5xl bg-primary p-6 md:p-12 rounded-2xl md:rounded-4xl flex justify-center items-center flex-col"
    >
        <h2 class="text-white dark:text-slate-100 text-4xl md:text-5xl text-center font-black mb-4">
            Ready to boost your grades?
        </h2>
        <p class="text-lg md:text-xl text-center max-w-xl text-slate-200 font-medium mb-6">
            Join over 100 students who are already using ResKitt to streamline
            their studies and achieve their academic goals.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 sm:gap-4 gap-0 w-full">
            <Button href="#" moreClasses="bg-white dark:bg-black/60 text-primary dark:text-slate-100 font-black"
                >Get Started for Free</Button
            >
            <Button
                href="/about"
                moreClasses="text-primary font-black text-white border-blue-200 border-2"
                >Learn More</Button
            >
        </div>
    </div>
</section>
