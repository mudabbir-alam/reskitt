---
const { href, style, moreClasses, size, bg = "bg-primary" } = Astro.props;
const Tag = href ? "a" : "button";
const attrs = href ? { href } : { type: "button" as const };
const sizes = {
    sm: "px-2 py-1 rounded-lg",
    md: "px-4 py-2 text-lg rounded-xl",
    lg: "px-6 py-3 text-xl rounded-xl"
};
---

<Tag
    {...attrs}
    class:list = {["mt-4 text-center cursor-pointer", sizes[size], bg, moreClasses]}
    style={style}
>
    <slot />
</Tag>
